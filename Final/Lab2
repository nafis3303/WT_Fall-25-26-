        $degree = $_POST["degree"];
    }

     if (empty($_POST["blood_group"])) {
        $bloodgrouperror = "Blood group is required";
    } else {
        $blood_group = test_input($_POST["blood_group"]);
    }



}
function test_input($data) {
    $data = trim($data);  
    return $data;
}
